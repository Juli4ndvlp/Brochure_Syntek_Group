/* ==========================================================================
   SYNTEK GROUP — DESIGN SYSTEM & STYLES
   Fabricación Metalmecánica & Carpintería Industrial (Metal & Madera)
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@500;600;700;800;900&display=swap');

:root {
  /* Industrial Palette - Copper & Steel Theme */
  --copper: #C1712B;
  --copper-hover: #D98032;
  --copper-dark: #9E561B;
  --copper-glow: rgba(193, 113, 43, 0.25);
  --copper-border: rgba(193, 113, 43, 0.45);
  
  --steel-blue: #1E4E8C;
  --steel-blue-glow: rgba(30, 78, 140, 0.25);
  
  /* Dark Mode Default Tokens */
  --bg-main: #0C0E11;
  --bg-card: #15181D;
  --bg-card-hover: #1D2128;
  --bg-nav: rgba(12, 14, 17, 0.90);
  --border-color: #252A33;
  --border-highlight: rgba(255, 255, 255, 0.08);
  
  --text-main: #F1F3F5;
  --text-muted: #9AA0AC;
  --text-dim: #6C727F;
  
  --badge-bg: rgba(193, 113, 43, 0.12);
  --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.25);
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.35);
  --shadow-lg: 0 16px 40px rgba(0, 0, 0, 0.5);
  --shadow-copper: 0 8px 30px rgba(193, 113, 43, 0.25);

  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --radius-pill: 999px;

  --transition-fast: 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  --transition-normal: 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Light Mode Overrides */
[data-theme="light"] {
  --bg-main: #F4F3F0;
  --bg-card: #FFFFFF;
  --bg-card-hover: #F8F7F4;
  --bg-nav: rgba(244, 243, 240, 0.94);
  --border-color: #E2DFD7;
  --border-highlight: rgba(0, 0, 0, 0.08);
  
  --text-main: #181A1D;
  --text-muted: #565C66;
  --text-dim: #848A96;
  
  --badge-bg: rgba(193, 113, 43, 0.1);
  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.06);
  --shadow-md: 0 6px 20px rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 12px 32px rgba(0, 0, 0, 0.12);
}

/* Global Reset */
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 80px;
}

body {
  background-color: var(--bg-main);
  color: var(--text-main);
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  line-height: 1.6;
  font-size: 15px;
  overflow-x: hidden;
  transition: background-color var(--transition-normal), color var(--transition-normal);
  padding-bottom: 70px; /* Space for mobile bottom bar */
}

@media (min-width: 769px) {
  body {
    padding-bottom: 0;
  }
}

h1, h2, h3, h4, h5, h6 {
  font-family: 'Montserrat', sans-serif;
  color: var(--text-main);
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: -0.02em;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

/* Utility Containers */
.container {
  width: 100%;
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 24px;
}

.section {
  padding: 80px 0;
  position: relative;
  border-bottom: 1px solid var(--border-color);
}

/* Section Tag Badges */
.section-tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--badge-bg);
  color: var(--copper);
  border: 1px solid var(--copper-border);
  padding: 6px 16px;
  border-radius: var(--radius-pill);
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin-bottom: 14px;
}

.section-title {
  font-size: clamp(26px, 4vw, 38px);
  font-weight: 800;
  margin-bottom: 16px;
}

.section-title span {
  color: var(--copper);
}

.lead {
  font-size: clamp(14px, 2vw, 17px);
  color: var(--text-muted);
  max-width: 840px;
  line-height: 1.65;
  margin-bottom: 28px;
}

/* Button System */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 12px 24px;
  border-radius: var(--radius-md);
  font-family: 'Montserrat', sans-serif;
  font-weight: 700;
  font-size: 14px;
  cursor: pointer;
  border: none;
  transition: all var(--transition-normal);
  white-space: nowrap;
}

.btn-primary {
  background: linear-gradient(135deg, var(--copper), var(--copper-dark));
  color: #FFFFFF;
  box-shadow: var(--shadow-copper);
}

.btn-primary:hover {
  background: linear-gradient(135deg, var(--copper-hover), var(--copper));
  transform: translateY(-2px);
  box-shadow: 0 10px 28px rgba(193, 113, 43, 0.4);
}

.btn-secondary {
  background: var(--bg-card);
  color: var(--text-main);
  border: 1px solid var(--border-color);
}

.btn-secondary:hover {
  background: var(--bg-card-hover);
  border-color: var(--copper);
  color: var(--copper);
  transform: translateY(-2px);
}

.btn-whatsapp {
  background: #25D366;
  color: #FFFFFF;
  box-shadow: 0 6px 20px rgba(37, 211, 102, 0.25);
}

.btn-whatsapp:hover {
  background: #20BA5A;
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(37, 211, 102, 0.35);
}

/* Navigation Header */
.nav-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  background: var(--bg-nav);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--border-color);
  transition: background var(--transition-normal);
}

.nav-container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 74px;
}

.nav-brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.nav-brand-text {
  font-family: 'Montserrat', sans-serif;
  font-weight: 800;
  font-size: 18px;
  letter-spacing: -0.5px;
  display: flex;
  flex-direction: column;
}

.nav-brand-text small {
  font-size: 10px;
  color: var(--copper);
  font-weight: 600;
  letter-spacing: 1px;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 4px;
  overflow-x: auto;
  padding: 4px 0;
}

.nav-link {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-muted);
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  transition: all var(--transition-fast);
}

.nav-link:hover, .nav-link.active {
  color: var(--text-main);
  background: rgba(255, 255, 255, 0.06);
}

.nav-link.active {
  color: var(--copper);
  background: var(--badge-bg);
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.theme-toggle-btn {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  color: var(--text-main);
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 600;
}

.mobile-menu-toggle {
  display: none;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  color: var(--text-main);
  padding: 8px 12px;
  border-radius: var(--radius-sm);
  font-size: 18px;
  cursor: pointer;
}

/* ==========================================================================
   HERO SECTION & CIRCULAR EMBLEM LOGO FIX
   ========================================================================== */
.hero-section {
  padding: 60px 0 50px;
  text-align: center;
  position: relative;
  overflow: hidden;
  background: radial-gradient(circle at 50% 15%, rgba(193, 113, 43, 0.12) 0%, transparent 60%);
}

/* Natural Circular Logo Emblem Frame */
.hero-logo-box {
  margin: 0 auto 28px;
  width: 150px;
  height: 150px;
  border-radius: 50%;
  background: #FFFFFF; /* White background shield to blend logo seamlessly */
  padding: 10px;
  border: 3px solid var(--copper);
  box-shadow: 0 0 35px rgba(193, 113, 43, 0.35), var(--shadow-md);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

/* Rotating Metallic Ring Effect */
.hero-logo-box::after {
  content: "";
  position: absolute;
  inset: -4px;
  border-radius: 50%;
  border: 2px dashed var(--copper-dark);
  opacity: 0.5;
  animation: spin-glow 25s linear infinite;
  pointer-events: none;
}

@keyframes spin-glow {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* Circular Clipping for Logo Image (Fixes Square Box) */
.hero-logo-box img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  border-radius: 50%;
  clip-path: circle(49% at 50% 50%);
  transition: transform 0.4s ease;
}

.hero-logo-box:hover img {
  transform: scale(1.06);
}

.hero-title {
  font-size: clamp(32px, 6vw, 54px);
  font-weight: 900;
  margin-bottom: 16px;
  letter-spacing: -1.5px;
}

.hero-subtitle {
  font-size: clamp(15px, 2.5vw, 19px);
  color: var(--text-muted);
  max-width: 800px;
  margin: 0 auto 32px;
}

.hero-cta-group {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 44px;
}

/* Hero Key Stats Bar */
.hero-stats-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: 16px;
  margin-top: 20px;
}

.stat-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  padding: 18px;
  border-radius: var(--radius-md);
  text-align: center;
  transition: transform var(--transition-normal), border-color var(--transition-normal);
}

.stat-card:hover {
  transform: translateY(-4px);
  border-color: var(--copper);
}

.stat-num {
  font-family: 'Montserrat', sans-serif;
  font-size: 28px;
  font-weight: 800;
  color: var(--copper);
  display: block;
}

.stat-label {
  font-size: 12px;
  color: var(--text-muted);
  font-weight: 600;
  margin-top: 4px;
}

/* Material Badges */
.materials-badge-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 20px;
}

.mat-badge {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  color: var(--text-main);
  padding: 8px 16px;
  border-radius: var(--radius-pill);
  font-size: 13px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  transition: all var(--transition-fast);
}

.mat-badge:hover {
  border-color: var(--copper);
  color: var(--copper);
  transform: translateY(-2px);
}

/* Stepper Component */
.stepper-container {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 14px;
  margin-top: 24px;
}

.step-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-md);
  padding: 18px;
  cursor: pointer;
  transition: all var(--transition-normal);
}

.step-card:hover, .step-card.active {
  border-color: var(--copper);
  background: var(--bg-card-hover);
}

.step-num {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: var(--badge-bg);
  color: var(--copper);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 800;
  font-size: 13px;
  margin-bottom: 10px;
}

.step-card.active .step-num {
  background: var(--copper);
  color: #FFFFFF;
}

.step-title {
  font-size: 14px;
  font-weight: 700;
  margin-bottom: 4px;
}

.step-desc {
  font-size: 12px;
  color: var(--text-muted);
  line-height: 1.4;
}

/* Catalog Controls & Filter Tabs */
.catalog-controls {
  margin-bottom: 32px;
}

.catalog-search-box {
  position: relative;
  max-width: 480px;
  margin: 0 auto 20px;
}

.catalog-search-input {
  width: 100%;
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  color: var(--text-main);
  padding: 12px 20px 12px 44px;
  border-radius: var(--radius-pill);
  font-size: 14px;
  outline: none;
  transition: all var(--transition-normal);
}

.catalog-search-input:focus {
  border-color: var(--copper);
  box-shadow: var(--shadow-copper);
}

.catalog-search-icon {
  position: absolute;
  left: 16px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--text-dim);
}

.catalog-tabs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  flex-wrap: wrap;
}

.tab-btn {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  color: var(--text-muted);
  padding: 8px 18px;
  border-radius: var(--radius-pill);
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-normal);
}

.tab-btn:hover {
  color: var(--text-main);
  border-color: var(--text-muted);
}

.tab-btn.active {
  background: var(--copper);
  color: #FFFFFF;
  border-color: var(--copper);
  box-shadow: var(--shadow-copper);
}

/* Product Cards & Focused Image Containers */
.product-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
  gap: 24px;
}

.product-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform var(--transition-normal), border-color var(--transition-normal), box-shadow var(--transition-normal);
}

.product-card:hover {
  transform: translateY(-6px);
  border-color: var(--copper-border);
  box-shadow: var(--shadow-md);
}

.product-img-focus {
  position: relative;
  width: 100%;
  aspect-ratio: 4/3;
  background: #000;
  overflow: hidden;
  cursor: pointer;
}

.product-img-focus img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
}

.product-card:hover .product-img-focus img {
  transform: scale(1.07);
}

.img-overlay-action {
  position: absolute;
  inset: 0;
  background: rgba(12, 14, 17, 0.55);
  backdrop-filter: blur(3px);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity var(--transition-normal);
}

.product-img-focus:hover .img-overlay-action {
  opacity: 1;
}

.img-overlay-btn {
  background: var(--copper);
  color: #FFFFFF;
  padding: 8px 16px;
  border-radius: var(--radius-pill);
  font-size: 12px;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 6px;
  box-shadow: var(--shadow-md);
}

.category-tag-badge {
  position: absolute;
  top: 12px;
  left: 12px;
  background: rgba(12, 14, 17, 0.85);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.15);
  color: #FFFFFF;
  padding: 4px 10px;
  border-radius: var(--radius-pill);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
}

.ref-disclaimer-tag {
  position: absolute;
  bottom: 10px;
  right: 10px;
  background: rgba(193, 113, 43, 0.9);
  color: #FFFFFF;
  padding: 3px 8px;
  border-radius: var(--radius-sm);
  font-size: 10px;
  font-weight: 700;
}

.product-card-body {
  padding: 20px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.product-title {
  font-size: 17px;
  font-weight: 700;
  margin-bottom: 8px;
}

.product-desc {
  font-size: 13px;
  color: var(--text-muted);
  line-height: 1.5;
  margin-bottom: 14px;
  flex: 1;
}

.product-spec-list {
  list-style: none;
  margin-bottom: 16px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.product-spec-list li {
  font-size: 12px;
  color: var(--text-muted);
}

.product-card-actions {
  display: flex;
  gap: 8px;
  margin-top: auto;
}

.product-card-actions .btn {
  flex: 1;
  padding: 8px 12px;
  font-size: 12px;
}

/* Info Cards Grid */
.grid-three {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 20px;
}

.info-card {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  padding: 24px;
  border-radius: var(--radius-lg);
  transition: all var(--transition-normal);
}

.info-card:hover {
  border-color: var(--copper);
  transform: translateY(-4px);
}

.info-card-icon {
  font-size: 26px;
  margin-bottom: 12px;
}

.info-card-title {
  font-size: 17px;
  font-weight: 700;
  margin-bottom: 8px;
}

.info-card-desc {
  font-size: 13px;
  color: var(--text-muted);
  line-height: 1.6;
}

/* Contact Footer */
.footer-contact {
  background: var(--bg-card);
  border-top: 1px solid var(--border-color);
  padding: 50px 0 30px;
}

.contact-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 30px;
  margin-bottom: 30px;
}

.contact-item-title {
  font-size: 15px;
  font-weight: 700;
  margin-bottom: 10px;
  color: var(--copper);
}

.contact-item-text {
  font-size: 13px;
  color: var(--text-muted);
  line-height: 1.6;
}

.footer-bottom {
  border-top: 1px solid var(--border-color);
  padding-top: 20px;
  text-align: center;
  font-size: 12px;
  color: var(--text-dim);
}

/* ==========================================================================
   INTERACTIVE MODALS
   ========================================================================== */

.modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 2000;
  background: rgba(8, 10, 12, 0.85);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  opacity: 0;
  pointer-events: none;
  transition: opacity var(--transition-normal);
}

.modal-backdrop.open {
  opacity: 1;
  pointer-events: auto;
}

.modal-dialog {
  background: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  width: 100%;
  max-width: 880px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: var(--shadow-lg);
  position: relative;
  transform: scale(0.95);
  transition: transform var(--transition-normal);
}

.modal-backdrop.open .modal-dialog {
  transform: scale(1);
}

.modal-close-btn {
  position: absolute;
  top: 14px;
  right: 14px;
  background: rgba(0, 0, 0, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  z-index: 10;
  font-size: 18px;
}

.modal-close-btn:hover {
  background: var(--copper);
  border-color: var(--copper);
}

.lightbox-body {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
}

.lightbox-img-box {
  background: #000;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 320px;
}

.lightbox-img-box img {
  width: 100%;
  max-height: 500px;
  object-fit: contain;
}

.lightbox-details {
  padding: 28px;
  display: flex;
  flex-direction: column;
}

.quote-modal-header {
  padding: 20px 28px;
  border-bottom: 1px solid var(--border-color);
}

.quote-modal-body {
  padding: 28px;
}

.form-group {
  margin-bottom: 18px;
}

.form-label {
  display: block;
  font-size: 13px;
  font-weight: 700;
  margin-bottom: 6px;
}

.form-select, .form-input, .form-textarea {
  width: 100%;
  background: var(--bg-main);
  border: 1px solid var(--border-color);
  color: var(--text-main);
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  font-size: 13px;
  outline: none;
  font-family: inherit;
}

.form-select:focus, .form-input:focus, .form-textarea:focus {
  border-color: var(--copper);
}

.pending-badge {
  background: rgba(234, 179, 8, 0.12);
  border: 1px solid rgba(234, 179, 8, 0.3);
  color: #EAB308;
  padding: 6px 12px;
  border-radius: var(--radius-sm);
  font-size: 11px;
  font-weight: 600;
  margin-top: 8px;
  display: inline-block;
}

/* ==========================================================================
   MOBILE BOTTOM QUICK CONTACT BAR
   ========================================================================== */
.mobile-bottom-bar {
  display: none;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: var(--bg-nav);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-top: 1px solid var(--border-color);
  padding: 10px 16px;
  gap: 10px;
}

@media (max-width: 768px) {
  .mobile-bottom-bar {
    display: flex;
  }
}

/* ==========================================================================
   RESPONSIVE BREAKPOINTS (PC, TABLET, MOBILE)
   ========================================================================== */
@media (max-width: 992px) {
  .mobile-menu-toggle {
    display: block;
  }
  
  .nav-links {
    position: fixed;
    top: 74px;
    left: 0;
    right: 0;
    background: var(--bg-nav);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-color);
    flex-direction: column;
    padding: 16px 24px;
    gap: 10px;
    display: none;
    box-shadow: var(--shadow-lg);
  }
  
  .nav-links.mobile-open {
    display: flex;
  }
  
  .lightbox-body {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 600px) {
  .product-grid {
    grid-template-columns: 1fr;
  }
  
  .hero-logo-box {
    width: 120px;
    height: 120px;
  }
  
  .hero-cta-group {
    flex-direction: column;
    width: 100%;
  }
  
  .hero-cta-group .btn {
    width: 100%;
  }
}